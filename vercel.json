{
  "builds": [
    {
      "src": "public/**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "public/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/**/*.php",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/abstract.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/(abstract|team|milestones|publication|event|results)\\.php",
      "dest": "/public/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
