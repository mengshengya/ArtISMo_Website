{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "public/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git/**,public/assets/**,artismo-website-deploy.zip,**/*.aux,**/*.log,**/*.fls,**/*.fdb_latexmk,**/*.synctex.gz,**/*.toc,**/*.out}"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/public/abstract.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/(abstract|team|publication|event|results)\\.php",
      "dest": "/public/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
