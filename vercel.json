{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git/**,public/assets/**,artismo-website-deploy.zip,**/*.aux,**/*.log,**/*.fls,**/*.fdb_latexmk,**/*.synctex.gz,**/*.toc,**/*.out}"
    }
  },
  "routes": [
    {
      "src": "/(robots\\.txt|sitemap\\.xml|google2474259ca69870a8\\.html|googleaa680cea3c532e64\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/api/abstract.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(abstract|team|publication|event|results)\\.php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/(abstract|team|publication|event|results)",
      "dest": "/api/$1.php"
    }
  ]
}
